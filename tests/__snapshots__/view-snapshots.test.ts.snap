  font-size: 1.35rem;
  line-height: 1.5;
  margin-top: 1rem;
}
.steps-kitchen-checklist label,
.steps-kitchen-single label {
  display: flex;
  align-items: center;
  gap: 0.85rem;
  padding: 0.6rem 0.25rem;
}
.steps-kitchen-checklist input[type="checkbox"],
.steps-kitchen-single input[type="checkbox"] {
  width: 1.05rem;
  height: 1.05rem;
  accent-color: var(--color-accent);
  flex-shrink: 0;
}
.kitchen-submode-switcher {
  margin: 0 0 1rem;
}
.kitchen-submode-switcher button,
.steps-kitchen-nav button {
  font-size: 0.95rem;
  padding: 0.4rem 0.85rem;
  min-height: 2rem;
}
.steps-kitchen-progress {
  font-size: 1.15rem;
  font-weight: bold;
}
</style><nav aria-label="Kitchen mode sub-view switcher" class="kitchen-submode-switcher"><button type="button" data-kitchen-submode-target="checklist" aria-pressed="false">Checklist</button><button type="button" data-kitchen-submode-target="single" aria-pressed="true">One at a time</button></nav><ol class="steps-kitchen-checklist" data-kitchen-submode="checklist" hidden><li data-accent="accent-1"><label><input type="checkbox" data-key="step-0"/>Rinse chana (½ cup) + mung (½ cup) dal</label></li><li data-accent="accent-1"><label><input type="checkbox" data-key="step-1"/>Boil with water (3 cup), turmeric (½ tsp), bay leaf, salt (½ tsp)</label></li><li data-accent="accent-1"><label><input type="checkbox" data-key="step-2"/>Mash; discard bay leaf</label></li><li data-accent="accent-2"><label><input type="checkbox" data-key="step-3"/>Bloom cumin (1 tsp) + curry leaves (8) in Ghee (2 tbsp)</label></li><li data-accent="accent-2"><label><input type="checkbox" data-key="step-4"/>Sauté garlic (4) + onion (1 medium) till golden</label></li><li data-accent="accent-2"><label><input type="checkbox" data-key="step-5"/>Add tomato (1) + coriander (1 tsp) + chili powder (½ tsp), cook till oil separates</label></li><li data-accent="accent-3"><label><input type="checkbox" data-key="step-6"/>Combine, add remaining salt (½ tsp), simmer 2 min</label></li><li data-accent="accent-3"><label><input type="checkbox" data-key="step-7"/>Stir in garam masala (0.3 tsp), serve</label></li></ol><div class="steps-kitchen-single" data-kitchen-submode="single"><p class="steps-kitchen-progress">Step 1 of 8</p><div data-accent="accent-1"><label><input type="checkbox" data-key="step-0"/>Rinse chana (½ cup) + mung (½ cup) dal</label></div><div class="steps-kitchen-nav"><button type="button" data-kitchen-step-nav="back" disabled>Back</button><button type="button" data-kitchen-step-nav="next">Next</button></div></div>"
`;

exports[`view component snapshots (mixed-dal-tadka, default view state) > StepsMise 1`] = `"<div class="steps-mise"><section class="mise-section" aria-label="Prep checklist"><h4>Prep</h4><ul class="mise-ingredients"><li><label><input type="checkbox" data-key="ingredient-0"/>½ cup Chana dal</label></li><li><label><input type="checkbox" data-key="ingredient-1"/>½ cup Mung dal (split, yellow)</label></li><li><label><input type="checkbox" data-key="ingredient-2"/>3 cup Water (for cooking dal)</label></li><li><label><input type="checkbox" data-key="ingredient-3"/>½ tsp Turmeric powder</label></li><li><label><input type="checkbox" data-key="ingredient-4"/>1 tsp Salt</label></li><li><label><input type="checkbox" data-key="ingredient-5"/>1 Bay leaf</label></li><li><label><input type="checkbox" data-key="ingredient-6"/>2 tbsp Ghee</label></li><li><label><input type="checkbox" data-key="ingredient-7"/>1 tsp Cumin seeds</label></li><li><label><input type="checkbox" data-key="ingredient-8"/>8 Curry leaves</label></li><li><label><input type="checkbox" data-key="ingredient-9"/>4 Garlic cloves (minced)</label></li><li><label><input type="checkbox" data-key="ingredient-10"/>1 medium Onion (finely chopped)</label></li><li><label><input type="checkbox" data-key="ingredient-11"/>1 Tomato (chopped, plum or regular)</label></li><li><label><input type="checkbox" data-key="ingredient-12"/>1 tsp Coriander powder</label></li><li><label><input type="checkbox" data-key="ingredient-13"/>½ tsp Red chili powder</label></li><li><label><input type="checkbox" data-key="ingredient-14"/>0.3 tsp Garam masala</label></li><li><label><input type="checkbox" data-key="ingredient-15"/>Pinch of cumin powder (optional)</label></li><li><label><input type="checkbox" data-key="ingredient-16"/>Dry chilli (optional)</label></li></ul></section><section class="mise-section" aria-label="Method"><h4>Method</h4><ol class="mise-method"><li data-accent="accent-1">Rinse the chana dal (½ cup) and mung dal (½ cup) together under cold water until it runs mostly clear.</li><li data-accent="accent-1">Add the rinsed dal to a pot with the water (3 cup), turmeric powder (½ tsp), bay leaf, and half of the salt (½ tsp). Bring to a boil, then reduce heat and simmer, partially covered, until soft and starting to break down.</li><li class="idle" data-accent="accent-1">Simmering, partially covered — no action needed.</li><li data-accent="accent-1">Remove the bay leaf. Whisk or lightly mash the dal to your preferred consistency (some like it chunky, some smooth). Set aside.</li><li data-accent="accent-2">In a small pan, heat the Ghee (2 tbsp) over medium heat. Add the cumin seeds (1 tsp) and let them sizzle for a few seconds, then add the curry leaves (8) and let them crackle.</li><li data-accent="accent-2">Add the garlic (4) and onion (1 medium). Sauté until the onion turns golden.</li><li data-accent="accent-2">Add the tomato (1), coriander powder (1 tsp), and red chili powder (½ tsp). Cook until the tomatoes soften and the oil starts to separate.</li><li data-accent="accent-3">Pour the tempering into the cooked dal. Add the remaining salt (½ tsp) to taste, and stir well. Simmer everything together for a couple minutes to let the flavors meld.</li><li data-accent="accent-3">Turn off the heat and stir in the garam masala (0.3 tsp). Serve hot with rice or roti.</li></ol></section></div>"`;

exports[`view component snapshots (mixed-dal-tadka, default view state) > StepsTimeline 1`] = `"<div class="steps-timeline"><ol><li data-accent="accent-1"><span class="timeline-marker">T−60m</span><span class="timeline-group">Lentils</span><span class="timeline-text">Rinse the chana dal (½ cup) and mung dal (½ cup) together under cold water until it runs mostly clear.</span></li><li data-accent="accent-1"><span class="timeline-marker">T−55m</span><span class="timeline-group">Lentils</span><span class="timeline-text">Add the rinsed dal to a pot with the water (3 cup), turmeric powder (½ tsp), bay leaf, and half of the salt (½ tsp). Bring to a boil, then reduce heat and simmer, partially covered, until soft and starting to break down.</span></li><li class="idle" data-accent="accent-1"><span class="timeline-marker">T−20m</span><span class="timeline-group">Lentils</span><span class="timeline-text">Simmering, partially covered — no action needed.</span></li><li data-accent="accent-1"><span class="timeline-marker">T−15m</span><span class="timeline-group">Lentils</span><span class="timeline-text">Remove the bay leaf. Whisk or lightly mash the dal to your preferred consistency (some like it chunky, some smooth). Set aside.</span></li><li data-accent="accent-2"><span class="timeline-marker">T−15m</span><span class="timeline-group">Tadka</span><span class="timeline-text">In a small pan, heat the Ghee (2 tbsp) over medium heat. Add the cumin seeds (1 tsp) and let them sizzle for a few seconds, then add the curry leaves (8) and let them crackle.</span></li><li data-accent="accent-2"><span class="timeline-marker">T−10m</span><span class="timeline-group">Tadka</span><span class="timeline-text">Add the garlic (4) and onion (1 medium). Sauté until the onion turns golden.</span></li><li data-accent="accent-2"><span class="timeline-marker">T−5m</span><span class="timeline-group">Tadka</span><span class="timeline-text">Add the tomato (1), coriander powder (1 tsp), and red chili powder (½ tsp). Cook until the tomatoes soften and the oil starts to separate.</span></li><li data-accent="accent-3"><span class="timeline-marker">T−2m</span><span class="timeline-group">Combine</span><span class="timeline-text">Pour the tempering into the cooked dal. Add the remaining salt (½ tsp) to taste, and stir well. Simmer everything together for a couple minutes to let the flavors meld.</span></li><li data-accent="accent-3"><span class="timeline-marker">T−0m</span><span class="timeline-group">Combine</span><span class="timeline-text">Turn off the heat and stir in the garam masala (0.3 tsp). Serve hot with rice or roti.</span></li></ol></div>"`;
